# Core
DATABASE_URL=postgresql://roamola:roamola@localhost:5432/roamola
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=

# Temporary M1-M3 dev gate (apps/web/middleware.ts) -- NOT the real auth
# system. Blocks the whole site behind one shared password while the build
# is in progress. Removed once M4 (Auth.js) lands.
DEV_ACCESS_PASSWORD=

# Auth & billing
# Self-hosted by default (Auth.js needs no external account) -- see docs/DECISIONS.md.
# If the Clerk path is chosen instead, uncomment and fill these two:
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Generation
ANTHROPIC_API_KEY=
GENERATION_ENABLED=false          # master switch; default OFF
GENERATION_DAILY_CAP=500          # hard ceiling, enforced in code

# Publishing controls
PUBLISH_ENABLED=false             # default OFF; flipped per BUILD.md §7.5 release stages
PUBLISH_MONTHLY_CAP=2000

# Storage & email
S3_ENDPOINT=                      # blank when using a Coolify-managed MinIO instance
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RESEND_API_KEY=

# Observability
SENTRY_DSN=
AXIOM_TOKEN=

# Feature flags
FLAG_ADS_ENABLED=false            # keep false until Phase 2 (master plan §2)
FLAG_STORE_ENABLED=false
FLAG_ASSETS_MODULE=false          # property module -- legal sign-off required, BUILD.md §18
